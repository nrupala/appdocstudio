# .gitignore for Checkinfo Ecosystem Apps
# Ignore OS-generated files
.DS_Store
Thumbs.db

# Ignore IDE files
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Ignore logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Ignore dependency directories
node_modules/
jspm_packages/
packages/
bower_components/

# Ignore build outputs
/dist/
/build/
/out/
/coverage/

# Ignore environment variables
.env
.env.*

# Ignore misc
*.bak
*.swp
*~